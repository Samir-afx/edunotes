# ============================================================================
# EDUNOTES — ENVIRONMENT CONFIGURATION
# ============================================================================

# Supabase Project URL & Anonymous Public API Key
# (Create a free project on https://supabase.com and copy credentials from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME=EduNotes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Limit (in MegaBytes)
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25

# Storage Bucket Names
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_NOTES=community-notes
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=user-avatars
